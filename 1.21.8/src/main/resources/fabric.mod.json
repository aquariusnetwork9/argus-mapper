{
  "schemaVersion": 1,
  "id": "argus-mapper",
  "version": "${version}",
  "name": "ARGUS Mapper",
  "description": "Uploads Xaero's World Map region files to the ARGUS spawn region mapping project, and bundles Aquarius Road Department (ARD) nether-highway condition reporting/HUD.",
  "authors": ["Aquarius Networks"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "tools.argus.uploader.fabric.ArgusUploaderClientMod",
      "com.aquariusnetwork.highwayconditions.HighwayConditionsFabricClient"
    ]
  },
  "mixins": [
    "argus-mapper-xaero.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": "*"
  },
  "recommends": {
    "xaeroworldmap": "*"
  }
}
