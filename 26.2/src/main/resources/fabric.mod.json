{
  "schemaVersion": 1,
  "id": "argus-mapper",
  "version": "${version}",
  "name": "ARGUS Mapper",
  "description": "Shares your Xaero's World Map with the ARGUS spawn region mapping project: live upload, blackzones and teleport protection.",
  "authors": ["Aquarius Networks"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "tools.argus.uploader.fabric.ArgusUploaderClientMod"
    ]
  },
  "mixins": [
    "argus-mapper-xaero.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "recommends": {
    "xaeroworldmap": "*"
  }
}
